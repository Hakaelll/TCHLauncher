{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TCHLauncher",
  "version": "0.45.0",
  "identifier": "com.tchlauncher.desktop",
  "build": {
    "beforeDevCommand": "node ./node_modules/vite/bin/vite.js --configLoader runner",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build --configLoader runner",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TCHLauncher",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#131217",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../docs/legal/THIRD_PARTY_LICENSES.txt": "licenses/THIRD_PARTY_LICENSES.txt",
      "../docs/legal/dependency-licenses.json": "licenses/dependency-licenses.json"
    }
  }
}
